{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mobile.ts",
    "build": "vite build --config vite.config.mobile.ts",
    "build:web": "vite build --config vite.config.mobile.ts",
    "lint": "eslint .",
    "preview": "vite preview --config vite.config.mobile.ts",
    "cap:sync": "npm run build:web && npx cap sync android",
    "android": "npm run cap:sync && npx cap open android",
    "apk:debug": "npm run cap:sync && powershell -ExecutionPolicy Bypass -File .\\scripts\\android-build.ps1 assembleDebug",
    "apk:release": "npm run cap:sync && powershell -ExecutionPolicy Bypass -File .\\scripts\\android-build.ps1 assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.55.0",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.542.0",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-datepicker": "^8.7.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.4"
  }
}
